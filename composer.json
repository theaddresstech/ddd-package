{
    "name": "theaddresstechnology/ddd",
    "description": "DDD Laravel-structure-generator",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [
        {
            "name": "theaddresstechnology",
            "email": "islamadel295@yahoo.com"
        }
    ],
    "require": {
        "php": "^8.4.1",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "spatie/laravel-activitylog": "^5.1.1",
        "spatie/laravel-query-builder": "^7.3.5",
        "laravel/passport": "^13.8"
    },
    "autoload": {
        "psr-4": {
            "theaddresstechnology\\DDD\\": "src/"
        },
        "files": [
            "src/Modules/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "bin": ["bin/ddd-doctor"],
    "extra": {
        "laravel":{
            "providers":[
                "theaddresstechnology\\DDD\\DomainDriverDesignServiceProvider"
            ]
        }
    },
    "suggest": {
        "wikimedia/composer-merge-plugin": "Required in the root application so src/Domain/*/composer.json autoload entries are merged. module:setup writes the include path."
    },
    "conflict": {
        "nwidart/laravel-modules": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.1",
        "orchestra/testbench": "^10.12 || ^11.3"
    }
}
