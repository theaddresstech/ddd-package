#!/usr/bin/env php
<?php

$autoload = $_composer_autoload_path ?? __DIR__.'/../vendor/autoload.php';
if (!is_file($autoload)) {
    $autoload = dirname(__DIR__, 3).'/autoload.php';
}
require $autoload;

$json = false;
$strict = false;
$modules = 'src/Domain';
$root = null;
foreach (array_slice($argv, 1) as $argument) {
    if ($argument === '--help' || $argument === '-h') {
        echo "Usage: ddd-doctor [application-directory] [--modules=src/Domain] [--json] [--strict]\nRead-only v2 upgrade checks; does not bootstrap Laravel or inspect databases.\n";
        exit(0);
    } elseif ($argument === '--json') {
        $json = true;
    } elseif ($argument === '--strict') {
        $strict = true;
    } elseif (str_starts_with($argument, '--modules=')) {
        $modules = substr($argument, strlen('--modules='));
    } elseif (!str_starts_with($argument, '-') && $root === null) {
        $root = $argument;
    } else {
        fwrite(STDERR, "Unknown argument. Run ddd-doctor --help.\n");
        exit(2);
    }
}
$report = (new \theaddresstechnology\DDD\Modules\UpgradeDoctor())->inspect($root ?? getcwd(), $modules);
if ($json) {
    echo json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR).PHP_EOL;
} else {
    foreach ($report['checks'] as $check) {
        echo strtoupper($check['severity']).' ['.$check['code'].'] '.$check['message'].PHP_EOL;
    }
}
exit($report['errors'] > 0 || ($strict && $report['warnings'] > 0) ? 1 : 0);
